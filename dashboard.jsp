<%@ page contentType="text/html;charset=UTF-8" %>
<!doctype html><html lang="en"><head><title>Booking Dashboard | Lanka Wings</title><%@ include file="/WEB-INF/jspf/head.jspf" %></head><body class="app-page"><%@ include file="/WEB-INF/jspf/header.jspf" %>
<main class="container page-pad"><div class="page-title"><span class="eyebrow navy">BOOKING MANAGEMENT</span><h1><%= "TRAVEL_AGENT".equals(role) ? "Travel Agent dashboard" : "Booking dashboard" %></h1></div>
<% if(err!=null){%><div class="alert error"><%=h(err)%></div><%}%>
<div class="stat-grid"><div class="stat"><b><%=request.getAttribute("bookingCount")%></b><span><%= "TRAVEL_AGENT".equals(role) ? "Bookings created by you" : "Bookings in your scope" %></span></div><div class="stat"><b><%=request.getAttribute("upcomingFlights")%></b><span>Upcoming bookable flights</span></div><div class="stat"><b><%=h(role)%></b><span>Signed-in role</span></div></div>
<div class="profile-grid" style="margin-top:22px"><section class="panel"><h2>Booking workflow</h2><p class="muted">Search flight → select client → choose seat → enter passenger details → create PNR → manage the booking.</p><p><a class="btn btn-orange" href="<%=cp%>/flights"><%= "TRAVEL_AGENT".equals(role) ? "Book for a Client" : "View Flights" %></a></p></section><section class="panel"><h2>Function boundary</h2><p class="muted">This project handles booking creation/management only. Payment gateway, refund processing, e-ticket management, flight administration and user administration are intentionally not included.</p><p><a class="btn btn-navy" href="<%=cp%>/bookings">Open Bookings</a></p></section></div>
</main><%@ include file="/WEB-INF/jspf/footer.jspf" %></body></html>
