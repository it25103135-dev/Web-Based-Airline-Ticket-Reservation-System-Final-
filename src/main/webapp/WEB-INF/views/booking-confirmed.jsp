<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.lankawings.model.Booking" %>
<!doctype html><html lang="en"><head><title>Payment successful | Lanka Wings</title><%@ include file="/WEB-INF/jspf/head.jspf" %></head><body class="app-page"><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container confirmation-wrap"><% Booking b=(Booking)request.getAttribute("booking");%><section class="confirmation-card" aria-labelledby="confirmation-title"><div class="confirmation-icon" aria-hidden="true"><svg viewBox="0 0 80 80"><circle cx="40" cy="40" r="36"/><path d="M23 40l12 12 23-25"/></svg></div><span class="eyebrow navy">PAYMENT COMPLETED</span><h1 id="confirmation-title">Payment successful!</h1><p>The transaction was accepted and the booking payment state is now confirmed.</p><div class="confirmation-reference"><span>Booking reference</span><strong><%=h(b.getPnr())%></strong></div><p class="muted">Ticket generation belongs to the separate Ticket Reservation module and is not included </p><div class="confirmation-actions"><a class="btn btn-orange" href="<%=cp%>/payments">Payment History →</a><a class="btn btn-outline" href="<%=cp%>/dashboard">Payment Dashboard</a></div></section></main><%@ include file="/WEB-INF/jspf/footer.jspf" %></body></html>
