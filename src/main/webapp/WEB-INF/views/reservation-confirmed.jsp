<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.text.SimpleDateFormat,com.lankawings.model.Booking,com.lankawings.model.Ticket" %>
<!doctype html><html lang="en"><head><title>Reservation Created | Lanka Wings</title><%@ include file="/WEB-INF/jspf/head.jspf" %></head><body class="app-page"><%@ include file="/WEB-INF/jspf/header.jspf" %>
<main class="container narrow page-pad"><% if(err!=null){%><div class="alert error"><%=h(err)%></div><%}%><% Booking b=(Booking)request.getAttribute("booking");Ticket t=(Ticket)request.getAttribute("ticket");if(b!=null){SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm");%>
<section class="panel reveal"><span class="eyebrow navy">RESERVATION CREATED</span><h1>Your seat is reserved</h1><p>Your passenger, flight and selected-seat details are saved.</p><div class="confirmation-reference"><span>Booking reference</span><strong><%=h(b.getPnr())%></strong></div><div class="ticket-grid"><span><small>Passenger</small><b><%=h(b.getPassengerName())%></b></span><span><small>Flight</small><b><%=h(b.getFlightNo())%></b></span><span><small>Route</small><b><%=h(b.getOrigin())%> → <%=h(b.getDestination())%></b></span><span><small>Departure</small><b><%=df.format(b.getDepartureTime())%></b></span><span><small>Seat</small><b><%=h(b.getSeatNumber())%></b></span><span><small>Fare</small><b>LKR <%=String.format("%,.2f",b.getFare())%></b></span></div>
<% if(t!=null){%><div class="alert success">Your e-ticket is ready.</div><a class="btn btn-orange" href="<%=cp%>/ticket?bookingId=<%=b.getBookingId()%>">View E-Ticket</a><%}else{%><div class="alert">Click once to mark this reservation as <b>PAID</b>, confirm it and immediately open the e-ticket.</div><form method="post" action="<%=cp%>/mark-paid"><%@ include file="/WEB-INF/jspf/csrf.jspf" %><input type="hidden" name="bookingId" value="<%=b.getBookingId()%>"><button class="btn btn-orange" type="submit">Mark Paid &amp; View E-Ticket</button></form><%}%>
<div class="confirmation-actions"><a class="btn btn-outline" href="<%=cp%>/reservations">My Reservations</a><a class="btn btn-outline" href="<%=cp%>/flights">Reserve Another Flight</a></div></section><%}%></main><%@ include file="/WEB-INF/jspf/footer.jspf" %></body></html>
