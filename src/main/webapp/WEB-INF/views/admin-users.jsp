<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,java.text.SimpleDateFormat,com.lankawings.model.User,com.lankawings.model.UserAudit" %>
<!doctype html><html lang="en"><head><title>User Management | Lanka Wings</title><%@ include file="/WEB-INF/jspf/head.jspf" %></head><body class="app-page"><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title"><span class="eyebrow navy">SYSTEM ADMINISTRATION</span><h1>User management</h1></div><% if(err!=null){ %><div class="alert error"><%=h(err)%></div><% } %>
<section class="panel"><h2>Create user account</h2><form method="post" data-validate><%@ include file="/WEB-INF/jspf/csrf.jspf" %><input type="hidden" name="action" value="create"><div class="form-grid"><label>Full name<input name="fullName" data-rule="name" required maxlength="80"></label><label>Username<input name="username" data-rule="username" required maxlength="30"></label><label>Email<input type="email" name="email" data-rule="email" required maxlength="120"></label><label>Mobile<input type="tel" name="phone" data-rule="phone" required maxlength="13"></label><label>Initial password<input type="password" name="password" data-rule="newpassword" data-toggle required maxlength="64"></label><label>Role<select name="role" required><% String[] roles=(String[])request.getAttribute("roles"); if(roles!=null) for(String rr:roles){ %><option value="<%=h(rr)%>"><%=h(rr)%></option><% } %></select></label><label>Status<select name="status"><option>ACTIVE</option><option>INACTIVE</option></select></label></div><button class="btn btn-orange" type="submit">Create Account</button></form></section>
<div class="toolbar"><input type="search" placeholder="Search by name, username, email or role..." data-filter="#usBody" data-filter-item="tr" data-status-select="#usStatus"><select id="usStatus"><option value="">All statuses</option><option value="ACTIVE">Active</option><option value="INACTIVE">Inactive</option></select></div>
<div class="table-wrap panel"><table><thead><tr><th>User</th><th>Contact</th><th>Role / Status</th><th>Joined</th><th>Admin update</th></tr></thead><tbody id="usBody"><% List<User> us=(List<User>)request.getAttribute("users"); int me=(Integer)session.getAttribute("userId"); SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy"); if(us!=null) for(User u:us){ boolean self=u.getUserId()==me; %><tr data-status="<%=h(u.getStatus())%>"><td><b><%=h(u.getFullName())%></b><% if(self){%><span class="self-tag">YOU</span><%}%><br><small class="muted">@<%=h(u.getUsername())%></small></td><td><%=h(u.getEmail())%><br><small class="muted"><%=h(u.getPhone())%></small></td><td><span class="badge"><%=h(u.getRole())%></span><br><span class="badge status-<%=h(u.getStatus())%>"><%=h(u.getStatus())%></span></td><td><%=u.getCreatedAt()==null?"":df.format(u.getCreatedAt())%></td><td><% if(!self){ %><form method="post" data-validate data-confirm="Save changes to <%=h(u.getUsername())%>?"><%@ include file="/WEB-INF/jspf/csrf.jspf" %><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="<%=u.getUserId()%>"><div class="form-grid"><label>Name<input name="fullName" data-rule="name" required maxlength="80" value="<%=h(u.getFullName())%>"></label><label>Email<input type="email" name="email" data-rule="email" required maxlength="120" value="<%=h(u.getEmail())%>"></label><label>Mobile<input type="tel" name="phone" data-rule="phone" required maxlength="13" value="<%=h(u.getPhone())%>"></label><label>Role<select name="role"><% for(String rr:roles){ %><option value="<%=h(rr)%>" <%=rr.equals(u.getRole())?"selected":""%>><%=h(rr)%></option><% } %></select></label><label>Status<select name="status"><option <%= "ACTIVE".equals(u.getStatus())?"selected":""%>>ACTIVE</option><option <%= "INACTIVE".equals(u.getStatus())?"selected":""%>>INACTIVE</option></select></label></div><button class="btn btn-navy" type="submit">Save user</button></form><% } else { %><small class="muted">Use Profile for your own details.</small><% } %></td></tr><% } %></tbody></table></div>
<section class="panel"><h2>Recent account audit</h2><div class="table-wrap"><table><thead><tr><th>Time</th><th>Actor</th><th>Target</th><th>Action</th><th>Details</th></tr></thead><tbody><% List<UserAudit> logs=(List<UserAudit>)request.getAttribute("audit"); if(logs!=null&& !logs.isEmpty()) for(UserAudit a:logs){ %><tr><td><%=h(a.getCreatedAt())%></td><td><%=h(a.getActorUsername())%></td><td><%=h(a.getTargetUsername())%></td><td><span class="badge"><%=h(a.getAction())%></span></td><td><%=h(a.getDetails())%></td></tr><% } else { %><tr><td colspan="5" class="muted">No account changes have been recorded yet.</td></tr><% } %></tbody></table></div></section>
</main><%@ include file="/WEB-INF/jspf/footer.jspf" %></body></html>
