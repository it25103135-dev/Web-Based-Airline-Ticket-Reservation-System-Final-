<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.text.SimpleDateFormat,com.lankawings.model.Booking,com.lankawings.model.Ticket" %>
<!doctype html><html lang="en"><head><title>E-Ticket | Lanka Wings</title><%@ include file="/WEB-INF/jspf/head.jspf" %></head><body class="app-page"><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container narrow page-pad"><%if(err!=null){%><div class="alert error"><%=h(err)%></div><%}%><%Booking b=(Booking)request.getAttribute("booking");Ticket t=(Ticket)request.getAttribute("ticket");if(b!=null&&t!=null){SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm");%>
<div class="ticket reveal"><div class="ticket-head"><div class="brand light"><span class="brand-mark">LW</span><span>Lanka <b>Wings</b></span></div><span>ELECTRONIC TICKET</span></div><div class="ticket-body"><div class="ticket-route"><div><small>FROM</small><strong><%=h(b.getOrigin())%></strong></div><span class="ticket-plane">✈</span><div><small>TO</small><strong><%=h(b.getDestination())%></strong></div></div><div class="ticket-grid"><span><small>Ticket Number</small><b><%=h(t.getTicketNumber())%></b></span><span><small>Passenger</small><b><%=h(b.getPassengerName())%></b></span><span><small>Flight</small><b><%=h(b.getFlightNo())%></b></span><span><small>Departure</small><b><%=df.format(b.getDepartureTime())%></b></span><span><small>Seat</small><b><%=h(b.getSeatNumber())%></b></span><span><small>PNR</small><b><%=h(b.getPnr())%></b></span><span><small>Ticket Status</small><b><%=h(t.getTicketStatus())%></b></span><span><small>Issued</small><b><%=df.format(t.getIssuedAt())%></b></span><span><small>Reservation / Paid</small><b><%=h(b.getBookingStatus())%> / <%=h(b.getPaymentStatus())%></b></span></div><div class="barcode-bars" data-code="<%=h(t.getTicketNumber())%>" aria-label="Ticket barcode"></div></div></div><div class="print-row"><button class="btn btn-orange" type="button" data-print>Print / Save E-Ticket</button><a class="btn btn-outline" href="<%=cp%>/reservations">My Reservations</a></div><%}%></main><%@ include file="/WEB-INF/jspf/footer.jspf" %></body></html>
