<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,java.text.SimpleDateFormat,com.lankawings.model.Booking,com.lankawings.model.Ticket" %>
<!doctype html><html lang="en"><head><title>My Reservations | Lanka Wings</title><%@ include file="/WEB-INF/jspf/head.jspf" %></head><body class="app-page"><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title reveal"><span class="eyebrow navy">TICKET RESERVATION</span><h1>My reservations</h1><p>Reserve a seat, then use the one-click <b>Mark Paid &amp; View Ticket</b> action to confirm it and open your e-ticket.</p></div><% if(err!=null){%><div class="alert error"><%=h(err)%></div><%}%>
<% List<Booking>bs=(List<Booking>)request.getAttribute("reservations");Map<Integer,Ticket>tm=(Map<Integer,Ticket>)request.getAttribute("tickets");SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm");%><div class="table-wrap"><table><thead><tr><th>PNR</th><th>Flight</th><th>Passenger</th><th>Seat</th><th>Departure</th><th>Reservation</th><th>Paid status</th><th>E-Ticket</th></tr></thead><tbody><%if(bs!=null&&!bs.isEmpty()){for(Booking b:bs){Ticket t=tm==null?null:tm.get(b.getBookingId());boolean usable=!b.isDeparted()&&!"CANCELLED".equals(b.getBookingStatus())&&!"CANCELLED".equals(b.getFlightStatus());%>
<tr><td><b><%=h(b.getPnr())%></b></td><td><%=h(b.getFlightNo())%><br><small><%=h(b.getOrigin())%> → <%=h(b.getDestination())%></small></td><td><%=h(b.getPassengerName())%></td><td><b><%=h(b.getSeatNumber())%></b></td><td><%=df.format(b.getDepartureTime())%></td><td><span class="badge"><%=h(b.getBookingStatus())%></span></td><td><span class="badge"><%=h(b.getPaymentStatus())%></span></td><td>
<%if(t!=null){%><a class="btn btn-navy small" href="<%=cp%>/ticket?bookingId=<%=b.getBookingId()%>">View E-Ticket</a>
<%}else if(usable){%><form method="post" action="<%=cp%>/mark-paid" style="margin:0"><%@ include file="/WEB-INF/jspf/csrf.jspf" %><input type="hidden" name="bookingId" value="<%=b.getBookingId()%>"><button class="btn btn-orange small" type="submit"><%="PAID".equals(b.getPaymentStatus())?"Create & View Ticket":"Mark Paid & View Ticket"%></button></form>
<%}else{%><span class="muted">Unavailable</span><%}%></td></tr><%}}else{%><tr><td colspan="8" class="empty">No reservations yet. <a href="<%=cp%>/flights">Find a flight</a>.</td></tr><%}%></tbody></table></div></main><%@ include file="/WEB-INF/jspf/footer.jspf" %></body></html>
