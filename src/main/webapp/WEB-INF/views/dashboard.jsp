<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,java.text.SimpleDateFormat,com.lankawings.model.Flight" %>
<!doctype html><html lang="en"><head><title>Ticket Reservation Dashboard | Lanka Wings</title><%@ include file="/WEB-INF/jspf/head.jspf" %></head><body class="app-page"><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title reveal"><span class="eyebrow navy">BOOK TICKET</span><h1>Ticket Reservation dashboard</h1><p>Search a flight, reserve a seat, then use one click to mark it paid and view the e-ticket.</p></div><%if(err!=null){%><div class="alert error"><%=h(err)%></div><%}%><section class="stats-grid"><div class="stat-card reveal"><span>My reservations</span><strong data-count="<%=request.getAttribute("reservationCount")%>">0</strong><small>Total created</small></div><div class="stat-card reveal"><span>Not paid</span><strong data-count="<%=request.getAttribute("pendingCount")%>">0</strong><small>Pending reservations</small></div><div class="stat-card reveal"><span>Paid & confirmed</span><strong data-count="<%=request.getAttribute("confirmedCount")%>">0</strong><small>Ready for ticket</small></div><div class="stat-card reveal"><span>E-tickets</span><strong data-count="<%=request.getAttribute("ticketCount")%>">0</strong><small>Issued documents</small></div></section>
<section class="panel reveal"><div class="panel-head"><div><span class="eyebrow navy">AVAILABLE NEXT</span><h2>Upcoming flights</h2></div><a class="btn btn-orange small" href="<%=cp%>/flights">Search all flights</a></div><div class="table-wrap"><table><thead><tr><th>Flight</th><th>Route</th><th>Departure</th><th>Seats left</th><th>Fare</th><th></th></tr></thead><tbody><%List<Flight>fs=(List<Flight>)request.getAttribute("nextFlights");SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm");if(fs!=null&&!fs.isEmpty()){for(Flight f:fs){%><tr><td><b><%=h(f.getFlightNo())%></b></td><td><%=h(f.getOrigin())%> → <%=h(f.getDestination())%></td><td><%=df.format(f.getDepartureTime())%></td><td><%=f.getAvailableSeats()%></td><td>LKR <%=String.format("%,.2f",f.getFare())%></td><td><a class="btn btn-navy small" href="<%=cp%>/reserve?flightId=<%=f.getFlightId()%>">Select seat</a></td></tr><%}}else{%><tr><td colspan="6" class="empty">No upcoming flights.</td></tr><%}%></tbody></table></div></section></main><%@ include file="/WEB-INF/jspf/footer.jspf" %></body></html>
