<%@ page pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jspf/flash.jspf" %>
<%@ include file="/WEB-INF/jspf/sky.jspf" %>
<%
    Object unreadObj = request.getAttribute("unreadCount");
    int unreadCount = unreadObj instanceof Integer ? (Integer) unreadObj : 0;
%>
<header class="topbar">
  <a class="brand" href="<%=cp%>/dashboard"><span class="brand-mark">LW</span><span>Lanka <b>Wings</b></span></a>
  <button class="nav-toggle" type="button" aria-label="Toggle menu">☰</button>
  <nav class="nav-links">
    <a class="<%=act(uri,"/dashboard")%>" href="<%=cp%>/dashboard">Dashboard</a>
    <a class="<%=act(uri,"/flights")%>" href="<%=cp%>/flights">Flights</a>
    <a class="<%=act(uri,"/bookings")%>" href="<%=cp%>/bookings">Bookings</a>
    <a class="<%=act(uri,"/tickets")%>" href="<%=cp%>/tickets">Tickets</a>
    <a class="<%=act(uri,"/payments")%>" href="<%=cp%>/payments">Payments</a>
    <a class="<%=act(uri,"/feedback")%>" href="<%=cp%>/feedback">Feedback</a>
    <a class="<%=act(uri,"/profile")%>" href="<%=cp%>/profile">Profile</a>
    <% if ("ADMIN".equals(role)) { %>
      <a class="<%=act(uri,"/admin/flights")%>" href="<%=cp%>/admin/flights">Manage Flights</a>
      <a class="<%=act(uri,"/admin/users")%>" href="<%=cp%>/admin/users">Users</a>
    <% } %>
    <a class="nav-bell" href="<%=cp%>/notifications" aria-label="Notifications" data-unread-url="<%=cp%>/notifications?format=count">🔔<span class="bell-badge" <%= unreadCount == 0 ? "hidden" : "" %>><%=unreadCount%></span></a>
    <form class="logout-form" method="post" action="<%=cp%>/logout"><%@ include file="/WEB-INF/jspf/csrf.jspf" %><button class="nav-cta" type="submit">Logout</button></form>
  </nav>
</header>
