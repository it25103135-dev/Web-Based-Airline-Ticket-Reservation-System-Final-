<%@ page pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jspf/flash.jspf" %>
<header class="topbar">
  <a class="brand" href="<%=cp%>/feedback"><span class="brand-mark">LW</span><span>Lanka <b>Wings</b></span></a>
  <button class="nav-toggle" type="button" aria-label="Toggle menu">☰</button>
  <nav class="nav-links">
    <a class="active" href="<%=cp%>/feedback"><%= "ADMIN".equals(role) ? "Passenger Care" : "Feedback" %></a>
    <span class="role-chip"><%= "ADMIN".equals(role) ? "Administrator" : "Passenger" %></span>
    <form class="logout-form" method="post" action="<%=cp%>/logout"><%@ include file="/WEB-INF/jspf/csrf.jspf" %><button class="nav-cta" type="submit">Logout</button></form>
  </nav>
</header>
