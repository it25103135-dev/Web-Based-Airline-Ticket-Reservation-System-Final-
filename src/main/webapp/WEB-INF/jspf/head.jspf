<%@ page pageEncoding="UTF-8" %>
<%@ page import="com.lankawings.util.HtmlUtil,com.lankawings.util.Csrf" %>
<%!
    /** Escape anything printed into HTML (prevents XSS). */
    static String h(Object o) { return HtmlUtil.esc(o == null ? "" : String.valueOf(o)); }
    static String act(String uri, String p) { return uri.endsWith(p) ? "active" : ""; }
%>
<%
    String cp = request.getContextPath();
    String role = (String) session.getAttribute("role");
    String uri = request.getAttribute("jakarta.servlet.forward.request_uri") != null
            ? (String) request.getAttribute("jakarta.servlet.forward.request_uri") : request.getRequestURI();
    String err = (String) request.getAttribute("error");
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#03045E">
<link rel="stylesheet" href="<%=cp%>/assets/css/style.css">
<link rel="stylesheet" href="<%=cp%>/assets/css/enhance.css">
<link rel="stylesheet" href="<%=cp%>/assets/css/electric.css">
<script src="<%=cp%>/assets/js/validate.js" defer></script>
<script src="<%=cp%>/assets/js/app.js" defer></script>
